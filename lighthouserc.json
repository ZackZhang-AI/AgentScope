{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- -p 3102",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 30000,
      "url": [
        "http://127.0.0.1:3102/",
        "http://127.0.0.1:3102/demos/code-fix-loop",
        "http://127.0.0.1:3102/case-study",
        "http://127.0.0.1:3102/zh",
        "http://127.0.0.1:3102/zh/demos/code-fix-loop",
        "http://127.0.0.1:3102/zh/case-study"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance", "accessibility", "best-practices"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "errors-in-console": "error"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./output/lighthouse"
    }
  }
}
