DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.7

# Public deployments should use recorded_only. Set local_sandbox only on trusted local machines.
AGENTSCOPE_EXECUTION_PROFILE=local_sandbox

# Optional. Raises the GitHub API rate limit for public PR imports.
GITHUB_TOKEN=

# Optional for the legacy workbench; required for persistent AgentScope run history.
DATABASE_URL=postgresql://agentscope:agentscope@localhost:54329/agentscope

# Optional. On server startup, running traces older than this are closed as runner_interrupted.
AGENTSCOPE_INTERRUPTED_AFTER_MS=300000
